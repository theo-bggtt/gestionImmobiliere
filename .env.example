# Copier en .env, puis remplacer les deux secrets par une valeur générée sur
# la machine — jamais reprise d'un dépôt, d'un README ou d'une PR :
#   openssl rand -base64 48
# (l'alphabet base64 passe tel quel dans ce fichier ; éviter espaces et
# guillemets, les scripts de sauvegarde le lisent comme un fichier shell)
POSTGRES_DB=gestion_immobiliere
POSTGRES_USER=gestion
POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me-too-generate-a-long-random-string

# Hors Docker (dev local), DATABASE_URL pointe vers localhost.
# Dans docker-compose, l'app reçoit sa propre DATABASE_URL vers le service "postgres".
DATABASE_URL=postgres://gestion:change-me@localhost:5432/gestion_immobiliere
PORT=3000

# Racine du stockage des photos. En Docker, un volume monte sur /donnees.
STOCKAGE_RACINE=./donnees/fichiers

# ── Mise en service (README, « Mise en service ») ────────────────────────
# Nom de domaine servi par Caddy. `localhost` = certificat auto-signé d'essai.
DOMAINE=localhost

# Nombre de proxys devant le processus Node. Le compose pose 1 pour le
# conteneur (Caddy) ; hors Docker, laisser vide ou 0 : on ne se fie à personne.
PROXYS_DE_CONFIANCE=

# L'inscription se ferme dès le premier compte. 1 pour en créer un autre,
# puis remettre à 0 et redémarrer.
AUTORISER_INSCRIPTION=0

# Sauvegardes (scripts/sauvegarde.sh) : dossier local, rétention, et cible
# rsync hors de la machine. Vide = les sauvegardes ne quittent pas le Pi.
SAUVEGARDES=./sauvegardes
RETENTION_JOURS=14
SAUVEGARDE_DESTINATION=
