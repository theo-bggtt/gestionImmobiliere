{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "rootDirs": [".", "./.react-router/types"],
    "noEmit": true
  },
  "include": ["app/**/*", "server/**/*.js", "scripts/**/*", "tests/**/*", "*.ts", ".react-router/types/**/*"]
}
